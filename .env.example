# Runtime environment: development, testing, or production
APP_ENV=development

# Public application origins used by the backend for links and CORS.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# The only browser-visible value in this file. Never put a secret in a
# NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend-only values. This passwordless local URL needs a matching trusted
# development PostgreSQL role; use your own credentials where local auth requires it.
DATABASE_URL=postgresql+psycopg://unicircle_dev@localhost:5432/unicircle_dev
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=unicircle-api
JWT_AUDIENCE=unicircle-web
JWT_ACCESS_TOKEN_MINUTES=30
OTP_PEPPER=replace-with-a-separate-long-random-secret
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Backend-only SMTP configuration for OTP email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=noreply@example.com

# Backend-only AI provider credential.
OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG ingestion is restricted to explicitly approved public CUET hosts and seeds.
# Add a related CUET subdomain only after reviewing and approving it.
RAG_ALLOWED_HOSTS=cuet.ac.bd
RAG_SEED_URLS=https://cuet.ac.bd/
RAG_MAX_PAGES=500
RAG_MAX_DEPTH=5
RAG_REQUEST_TIMEOUT_SECONDS=20
RAG_REQUESTS_PER_SECOND=1
