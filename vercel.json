{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_API_URL" }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "installCommand": "pip install -r requirements.lock && pip install '.[cloud]' && pip check",
      "buildCommand": "python -m app.modules.assistant.prepare_model",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "includeFiles": "app/modules/assistant/embedding_models/**",
          "excludeFiles": "{tests/**,.venv/**,__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
