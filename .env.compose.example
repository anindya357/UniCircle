# Local Docker development database only. Copy to ignored .env.compose.
# Never reuse these credentials for a production database.
POSTGRES_DB=unicircle_docker_dev
POSTGRES_USER=unicircle_docker_dev
POSTGRES_PASSWORD=replace-with-a-local-only-random-password
# Loopback only; 55432 avoids replacing an existing host PostgreSQL server.
POSTGRES_PORT=55432
