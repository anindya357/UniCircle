# Local Docker development database only. Copy to ignored .env.compose.
# Never reuse these credentials for a production database.
POSTGRES_DB=unicircle_docker_dev
POSTGRES_USER=unicircle_docker_dev
POSTGRES_PASSWORD=replace-with-a-local-only-random-password
# Loopback only; 55432 avoids replacing an existing host PostgreSQL server.
POSTGRES_PORT=55432

# Local stack configuration. Replace secrets with distinct random values.
# Alphanumeric local passwords work directly in the generated database URL.
# For reserved URI characters, set DOCKER_DATABASE_URL to a URL-encoded URL.
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
IMAGE_TAG=local
VCS_REF=unknown
JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=noreply@example.com

# Docker Desktop reaches the existing E-drive Ollama model installation here.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
RAG_KNOWLEDGE_MODE=curated
